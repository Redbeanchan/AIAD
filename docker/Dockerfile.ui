# syntax=docker/dockerfile:1.6
FROM python:3.10-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# deps for pillow
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
 && rm -rf /var/lib/apt/lists/*

# install UI deps
COPY docker/requirements.ui.txt /app/requirements.ui.txt
RUN pip install --upgrade pip \
 && pip install -r /app/requirements.ui.txt

# copy website app
COPY website /app/website

# gunicorn config
COPY docker/gunicorn.conf.py /app/gunicorn.conf.py

EXPOSE 8080

CMD ["gunicorn", "-c", "/app/gunicorn.conf.py", "website.app:app"]